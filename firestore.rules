rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /consultations/{docId} {
      allow read, write: if request.auth != null &&
        request.auth.token.email in [
          'sergej.semeniuk@gmail.com',
          'snezana.kuznecova@gmail.com'
        ];
    }
    match /meta/{docId} {
      allow read, write: if request.auth != null &&
        request.auth.token.email in [
          'sergej.semeniuk@gmail.com',
          'snezana.kuznecova@gmail.com'
        ];
    }
  }
}
